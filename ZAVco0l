local lastAllTarget = nil

ModeBtn.MouseButton1Click:Connect(function()
    if allLoopRunning then
        allLoopRunning = false
        State.allMode = false
        State.targetPlayer = nil
        State.targetPart = nil
        lastAllTarget = nil
        ModeBtn.Text = "◈  SINGLE TARGET"
        Deactivate()
        setStatus("⭕ Mode: Single", THEME.TextDim)
    else
        allLoopRunning = true
        State.allMode = true
        ModeBtn.Text = "◈  ALL PLAYERS"
        setStatus("⚔️ Mode: All", THEME.Red)
        task.spawn(function()
            while allLoopRunning do
                for _, plr in ipairs(Players:GetPlayers()) do
                    if not allLoopRunning then break end
                    if isValidTarget(plr) and lastAllTarget ~= plr then
                        State.targetPlayer = plr
                        State.targetPart = getRoot(plr)
                        lastAllTarget = plr
                        if not State.isActive then Activate() end
                        task.wait(1.0)
                    end
                end
                task.wait(0.1)
            end
            Deactivate()
            State.targetPlayer = nil
            State.targetPart = nil
            lastAllTarget = nil
        end)
    end
end)


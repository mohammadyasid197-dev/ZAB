local ServerFolder = Instance.new("Folder")
ServerFolder.Name = "ZABco0l_Server"
ServerFolder.Parent = Workspace

local ServerAuraParts = {}
local serverAuraAngle = 0

local function serverAuraUpdate(dt)
    if not (ServerState.Enabled and ServerState.Aura) then
        for _, p in ipairs(ServerAuraParts) do
            if p and p.Parent then p.Transparency = 1 end
        end
        return
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    serverAuraAngle = serverAuraAngle + dt * 2
    local style = AURA_STYLES[AuraState.StyleIndex] or AURA_STYLES[1]
    for i = 1, 12 do
        local p = ServerAuraParts[i]
        if not p or not p.Parent then
            p = Instance.new("Part")
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(0.5, 0.5, 0.5)
            p.Anchored = false
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.Material = Enum.Material.Neon
            p.Parent = ServerFolder
            ServerAuraParts[i] = p
            pcall(function() p:SetNetworkOwner(nil) end)
        end
        local ang = serverAuraAngle + (i / 12) * math.pi * 2
        local radius = AuraState.Radius
        local pos = root.Position + Vector3.new(
            math.cos(ang) * radius, math.sin(ang * 1.3) * 1.2, math.sin(ang) * radius
        )
        p.Velocity = (pos - p.Position) * 15
        if style.name:find("Rain") then
            p.Color = Color3.fromHSV((serverAuraAngle * 0.3 + i / 12) % 1, 1, 1)
        else
            p.Color = style.col1:Lerp(style.col2, i / 12)
        end
        p.Transparency = 0.2
    end
end

local function serverFling()
    local now = tick()
    if now - ServerState.LastFling < 0.1 then return end
    ServerState.LastFling = now
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and not obj:IsDescendantOf(LP.Character) then
            safe(function()
                obj.Velocity = Vector3.new(
                    math.random(-ServerState.FlingPower, ServerState.FlingPower),
                    math.random(ServerState.FlingPower/2, ServerState.FlingPower),
                    math.random(-ServerState.FlingPower, ServerState.FlingPower)
                )
            end)
        end
    end
end

local function serverRagdollAll()
    local now = tick()
    if now - ServerState.LastRagdoll < 0.5 then return end
    ServerState.LastRagdoll = now
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                safe(function()
                    hum.PlatformStand = true
                    hum.Sit = true
                    hum:ChangeState(Enum.HumanoidStateType.Physics)
                end)
            end
        end
    end
end

local function setupAntiReset()
    if not ServerState.AntiReset then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()

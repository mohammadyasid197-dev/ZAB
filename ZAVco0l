local function Activate()
    if State.isActive then return end
    if not State.targetPlayer and not State.orbitMode then
        setStatus("⚠ Pilih target dulu!", THEME.Gold)
        return
    end
    if State.targetPlayer and not isValidTarget(State.targetPlayer) and not State.orbitMode then
        setStatus("❌ Target tidak valid", THEME.Red)
        return
    end
    State.isActive = true
    State.scanAccum = 0
    ActionBtn.Text = "🔴  D E A C T I V A T E"
    ActionBtn.TextColor3 = Color3.fromRGB(255, 240, 240)
    ActionGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 40, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 20, 40)),
    })
    LivePill.BackgroundColor3 = Color3.fromRGB(24, 40, 28)
    LiveDot.BackgroundColor3 = THEME.Green
    LiveText.Text = "ACTIVE"
    LiveText.TextColor3 = THEME.Green
    setStatus(State.orbitMode and "🌀 Orbit Mode" or "🔥 Active", THEME.Green)
    if not State.orbitMode then
        local root = getRoot(State.targetPlayer)
        if root then
            State.targetPart = root
            safe(function() AnchorPart.CFrame = CFrame.new(root.Position) end)
        end
    end
    State.renderConn = RunService.RenderStepped:Connect(function(dt)
        if not State.isActive then return end
        if State.orbitMode then
            local char = LP.Character
            if not char then return end
            local lpRoot = char:FindFirstChild("HumanoidRootPart")
            if not lpRoot then return end
            local center = lpRoot.Position
            local parts = getgenv().ZABr0om_Net.Parts
            local count = #parts
            if count == 0 then return end
            State.orbitAngle = State.orbitAngle + dt * ORBIT_SPEED
            for i = count, 1, -1 do
                local part = parts[i]
                if not part or not part.Parent then
                    table.remove(parts, i)
                else
                    local align = part:FindFirstChild("ZB_Align")
                    if align and align.Enabled then align.Enabled = false end
                    local ang = State.orbitAngle + (i * (math.pi * 2 / math.max(count, 1)))
                    local targetPos = center + Vector3.new(
                        math.cos(ang) * ORBIT_RADIUS, 0, math.sin(ang) * ORBIT_RADIUS
                    )
                    part.Velocity = (targetPos - part.Position) * 8
                end
            end
            return
        end
        if State.targetPlayer and State.targetPlayer.Character then
            local r = State.targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if r then State.targetPart = r end
        end
        if State.targetPart and State.targetPart.Parent then
            safe(function()

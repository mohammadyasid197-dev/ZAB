    row.Size = UDim2.new(1, -SZ(16), 0, SZ(22))
    row.Position = UDim2.new(0, SZ(8), 0, yPos)
    row.BackgroundTransparency = 1
    row.Active = false
    row.ZIndex = 4

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0, SZ(76), 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = THEME.TextDim
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = SZ(12)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 5
    lbl.Active = false

    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1, -SZ(140), 0, SZ(10))
    track.Position = UDim2.new(0, SZ(76), 0.5, -SZ(5))
    track.BackgroundColor3 = Color3.fromRGB(30, 24, 48)
    track.BorderSizePixel = 0
    track.ZIndex = 5
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((defaultVal - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = THEME.Gold
    fill.BorderSizePixel = 0
    fill.ZIndex = 6
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size = UDim2.new(0, SZ(60), 1, 0)
    valLbl.Position = UDim2.new(1, -SZ(60), 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = string.format("%.1f", defaultVal)
    valLbl.TextColor3 = THEME.Text
    valLbl.Font = Enum.Font.Code
    valLbl.TextSize = SZ(12)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.ZIndex = 5
    valLbl.Active = false

    local hitbox = Instance.new("TextButton", track)
    hitbox.Size = UDim2.new(1, SZ(20), 3, 0)
    hitbox.Position = UDim2.new(0, -SZ(10), 0.5, 0)
    hitbox.AnchorPoint = Vector2.new(0, 0.5)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.AutoButtonColor = false
    hitbox.ZIndex = 10

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = {track = track, fill = fill, valLbl = valLbl, minV = minV, maxV = maxV}
        end
    end)
    hitbox.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = nil
        end
    end)

    return valLbl
end

local IntensityVal = makeSlider(AuraPanel, SZ(72),  "Intensity", 1.0, 0.1, 5.0)
local RadiusVal    = makeSlider(AuraPanel, SZ(98),  "Radius",    3.5, 1.0, 15.0)
local SpeedVal     = makeSlider(AuraPanel, SZ(124), "Speed",     2.0, 0.5, 10.0)

UIS.InputChanged:Connect(function(input)
    if not activeSlider then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local mx = input.Position.X
    local abs = activeSlider.track.AbsolutePosition.X
    local w = activeSlider.track.AbsoluteSize.X
    local pct = math.clamp((mx - abs) / w, 0, 1)
    activeSlider.fill.Size = UDim2.new(pct, 0, 1, 0)
    local val = activeSlider.minV + (activeSlider.maxV - activeSlider.minV) * pct
    activeSlider.valLbl.Text = string.format("%.1f", val)
end)


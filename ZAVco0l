-- 📏 AUTO SCALE (mobile & PC)
-- ============================================
local viewport = workspace.CurrentCamera.ViewportSize
local isMobile = UIS.TouchEnabled and not UIS.MouseEnabled
local baseW, baseH = 440, 920
local scale = 1

if isMobile then
    -- mobile: skala biar muat
    local maxW = viewport.X * 0.92
    local maxH = viewport.Y * 0.9
    scale = math.min(maxW / baseW, maxH / baseH, 1.1)
else
    -- PC: kalau layar kecil, scale down; kalau besar, scale up dikit
    if viewport.Y < 900 then
        scale = viewport.Y / 1000
    else
        scale = math.min(viewport.Y / 900, 1.25)
    end
end

local PANEL_W = math.floor(baseW * scale)
local PANEL_H = math.floor(baseH * scale)

-- font helper biar ke-scale
local function SZ(n) return math.floor(n * scale) end


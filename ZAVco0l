-- ============================================
local AuraFolder = Instance.new("Folder")
AuraFolder.Name = "ZABco0l_Aura"
AuraFolder.Parent = Workspace

local AuraParts = {}
local function createAuraPart(i)
    local p = Instance.new("Part")
    p.Name = "ZAB_Aura_" .. i
    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(0.4, 0.4, 0.4)
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Material = Enum.Material.Neon
    p.Transparency = 1
    p.Parent = AuraFolder
    local light = Instance.new("PointLight", p)
    light.Brightness = 4
    light.Range = 8
    return p
end

for i = 1, 24 do
    AuraParts[i] = { part = createAuraPart(i) }
end

local auraAngle = 0
RunService.Heartbeat:Connect(function(dt)
    if not UI.Parent then return end
    if not AuraState.Enabled then
        for _, a in ipairs(AuraParts) do
            if a.part.Parent and a.part.Transparency < 1 then
                a.part.Transparency = 1
            end
        end
        return
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local style = AURA_STYLES[AuraState.StyleIndex] or AURA_STYLES[1]
    auraAngle = auraAngle + dt * AuraState.Speed
    local count = #AuraParts
    for i, a in ipairs(AuraParts) do
        local p = a.part
        if not p.Parent then
            a.part = createAuraPart(i)
            p = a.part
        end
        local ang = auraAngle + (i / count) * math.pi * 2
        local y = math.sin((i / count) * math.pi * 2 + auraAngle * 1.3) * 1.5
        local radius = AuraState.Radius
        local pos = root.Position + Vector3.new(math.cos(ang) * radius, y, math.sin(ang) * radius)
        p.CFrame = CFrame.new(pos)
        p.Size = Vector3.new(0.4, 0.4, 0.4) * AuraState.Intensity
        p.Transparency = math.clamp(0.6 - AuraState.Intensity * 0.15, 0.1, 0.7)
        if style.name == "Rainbow" or style.name == "SvrRain" then
            p.Color = Color3.fromHSV((auraAngle * 0.3 + i / count) % 1, 1, 1)
        else
            p.Color = style.col1:Lerp(style.col2, i / count)
        end
        p.Material = (style.name:find("Shadow") or style.name:find("Void"))
            and Enum.Material.SmoothPlastic or Enum.Material.Neon
        local light = p:FindFirstChildOfClass("PointLight")
        if light then
            light.Color = p.Color
            light.Brightness = 2 * AuraState.Intensity
        end
    end
end)


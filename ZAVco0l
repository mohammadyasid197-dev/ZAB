InputBox.FocusLost:Connect(function(enter)
    if not enter then return end
    local query = InputBox.Text:lower()
    if query == "" then setStatus("⚠ Masukkan nama", THEME.Gold); return end
    local exact, starts, contains = nil, nil, nil
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local n, d = p.Name:lower(), p.DisplayName:lower()
            if n == query or d == query then exact = p; break
            elseif not starts and (n:sub(1, #query) == query or d:sub(1, #query) == query) then starts = p
            elseif not contains and (n:find(query, 1, true) or d:find(query, 1, true)) then contains = p
            else
                local dd = math.min(lev(query, n), lev(query, d))
                if dd < closestDist then closestDist = dd; closest = p end
            end
        end
    end
    local found = exact or starts or contains or (closestDist <= 3 and closest)
    if found then
        InputBox.Text = found.Name
        State.targetPlayer = found
        State.targetPart = getRoot(found)
        setStatus("🎯 Target: " .. found.Name, THEME.Cyan)
    else
        InputBox.Text = ""
        setStatus("❌ Tidak ditemukan", THEME.Red)
    end
end)


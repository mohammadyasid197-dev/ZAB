local function playSound(index)
    local now = tick()
    if now - lastClick < 0.15 then return end
    lastClick = now
    local data = SOUNDS[index]
    if not data then return end
    if activeSounds[index] then stopSound(index); return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local speaker = Instance.new("Part")
    speaker.Name = "ZAB_Speaker_" .. index
    speaker.Anchored = true
    speaker.CanCollide = false
    speaker.CanQuery = false
    speaker.CanTouch = false
    speaker.Transparency = 1
    speaker.Size = Vector3.new(1, 1, 1)
    speaker.CFrame = root and root.CFrame or CFrame.new(0, 5, 0)
    speaker.Parent = SoundFolder

    local sound = Instance.new("Sound")
    sound.SoundId = data.id
    sound.Volume = 3
    sound.PlaybackSpeed = 1
    sound.RollOffMaxDistance = 500
    sound.RollOffMinDistance = 5
    sound.RollOffMode = Enum.RollOffMode.InverseTapered
    sound.Looped = false
    sound.Parent = speaker

    local conn
    if root then
        conn = RunService.Heartbeat:Connect(function()
            if root and root.Parent and speaker and speaker.Parent then
                speaker.CFrame = root.CFrame
            end
        end)
    end

    local backup = Instance.new("Sound")
    backup.SoundId = data.id
    backup.Volume = 3
    backup.Parent = SoundService

    activeSounds[index] = {speaker = speaker, sound = sound, conn = conn, backup = backup}
    sound:Play()
    sound.Ended:Connect(function()
        if activeSounds[index] and activeSounds[index].sound == sound then
            stopSound(index)
        end
    end)
    safe(function() backup:Play() end)
    backup.Ended:Connect(function()
        if backup and backup.Parent then backup:Destroy() end
    end)
end

stopSound = function(index)
    local entry = activeSounds[index]
    if not entry then return end
    activeSounds[index] = nil
    safe(function() if entry.sound then entry.sound:Stop(); entry.sound:Destroy() end end)
    safe(function() if entry.conn then entry.conn:Disconnect() end end)
    safe(function() if entry.speaker then entry.speaker:Destroy() end end)
    safe(function() if entry.backup then entry.backup:Stop(); entry.backup:Destroy() end end)
end

